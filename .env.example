# Public Firebase web client config. Replace these demo values for a real project.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cn360-connect.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-cn360-connect
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Local development ONLY; remove for production builds. Android emulator uses 10.0.2.2.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9098

# Native Android Firebase client file; package must match ph.cn360connect.app.
# GOOGLE_SERVICES_JSON=./google-services.json

# Restricted Android Maps SDK key. Set this in .env.local or the build environment.
# GOOGLE_MAPS_ANDROID_API_KEY=

# Pair these only for local Firestore development. Android emulator:10.0.2.2.
# EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
# EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8088
